NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATA_DIR=./data

# Set the exact public origin in production, for example https://gomi.example.com
# Leave blank for same-origin development.
APP_ORIGIN=
TRUST_PROXY=false

# Use a long, unique random secret. Admin API is disabled when this is empty.
ADMIN_TOKEN=replace-with-a-long-random-secret

# Optional production TURN service. TURN_SHARED_SECRET uses Coturn's REST API auth.
# Example TURN_URLS: turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
TURN_URLS=
TURN_SHARED_SECRET=

# Optional static credentials (less secure; prefer TURN_SHARED_SECRET)
TURN_USERNAME=
TURN_CREDENTIAL=
